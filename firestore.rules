rules_version = '2';

// Reglas de seguridad de Firestore. Reemplazan las validaciones de
// "backend" del documento original (p. ej. "el clinicId pertenece al usuario").
// Todo PR que agregue colecciones o campos debe actualizar este archivo,
// docs/modelo-datos.md y las pruebas en functions/test/firestore.rules.test.ts.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Utilidades ----------
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().role == role
        && userData().estado == 'activo';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(fields) {
      return changedKeys().hasOnly(fields);
    }

    // Usuario con sesión y cuenta no suspendida (RF-02). Una cuenta
    // suspendida solo puede leer su propio perfil, para ver el aviso.
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().estado == 'activo';
    }

    function isClinicOwner(clinicId) {
      return signedIn()
        && get(/databases/$(database)/documents/clinics/$(clinicId)).data.ownerUid == request.auth.uid;
    }

    // ---------- users (RF-01, RF-02) ----------
    match /users/{uid} {
      allow read: if isSelf(uid);
      // Se crea solo desde la Edge Function completar-registro.
      allow create, delete: if false;
      // role, estado, clinicId y uid son inmutables desde la app
      // (estado lo cambia solo un administrador con el Admin SDK).
      allow update: if isSelf(uid)
        && resource.data.estado == 'activo'
        && onlyChanges(['lastLoginAt', 'displayName', 'photoURL', 'telefono', 'ciudad', 'direccion', 'onboardingVisto'])
        && request.resource.data.get('onboardingVisto', false) is bool;

      // Tokens FCM (RF-13). Borrar el propio token se permite siempre (logout).
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid) && isActive();
      }
    }

    // ---------- Validaciones de campos ----------
    // Valores en español, iguales a los enums de lib/core/domain.
    function animalTypes() {
      return ['perros', 'gatos', 'aves', 'roedores', 'reptiles', 'granja', 'exoticos'];
    }

    function isTime(t) {
      return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isDate(d) {
      return d is string && d.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // Campo opcional: ausente, null o texto de máximo maxLen caracteres.
    function optString(data, field, maxLen) {
      return data.get(field, null) == null
        || (data[field] is string && data[field].size() <= maxLen);
    }

    function validAnimalTypes(list) {
      return list is list && list.size() > 0 && list.hasOnly(animalTypes());
    }

    // RF-06: {apertura, cierre, duracionSlotMin}, apertura antes del cierre.
    function validOpeningHours(h) {
      return h is map
        && h.keys().hasOnly(['apertura', 'cierre', 'duracionSlotMin'])
        && isTime(h.apertura) && isTime(h.cierre) && h.apertura < h.cierre
        && h.duracionSlotMin is int
        && h.duracionSlotMin >= 5 && h.duracionSlotMin <= 480;
    }

    // ---------- clinics (RF-01, RF-04, RF-06, RF-09) ----------
    match /clinics/{clinicId} {
      allow read: if signedIn();
      // La crea solo la Edge Function completar-registro.
      allow create, delete: if false;

      // RF-04: la clínica dueña (activa) edita solo su perfil de atención.
      // nombre, lat/lng, geo, ownerUid y createdAt no se cambian desde la app.
      allow update: if hasRole('clinica')
        && resource.data.ownerUid == request.auth.uid
        && onlyChanges(['tiposAnimales', 'atencionEmergencias', 'horarioBase',
                        'telefono', 'direccion', 'estado'])
        && clinicFieldsValid(request.resource.data)
        && clinicStatusChangeValid();

      function clinicFieldsValid(data) {
        return (!('tiposAnimales' in changedKeys()) || validAnimalTypes(data.tiposAnimales))
          && (!('atencionEmergencias' in changedKeys()) || data.atencionEmergencias is bool)
          && (!('horarioBase' in changedKeys()) || validOpeningHours(data.horarioBase))
          && (!('telefono' in changedKeys())
              || (data.telefono is string && data.telefono.matches('^[0-9]{10}$')))
          && (!('direccion' in changedKeys())
              || (data.direccion is string && data.direccion.size() >= 3
                  && data.direccion.size() <= 200));
      }

      // Única transición permitida: 'incompleto' → 'activo', y solo si ya
      // tiene al menos un tipo de animal (RF-04, paso 7).
      function clinicStatusChangeValid() {
        return !('estado' in changedKeys())
          || (resource.data.estado == 'incompleto'
              && request.resource.data.estado == 'activo'
              && validAnimalTypes(request.resource.data.tiposAnimales));
      }

      // ---------- Catálogo de servicios (RF-05) ----------
      match /services/{serviceId} {
        allow read: if signedIn();
        allow create, update: if hasRole('clinica')
          && isClinicOwner(clinicId)
          && validService(request.resource.data);
        allow delete: if false; // borrado lógico: activo = false

        function validService(data) {
          return data.keys().hasOnly(['nombre', 'categoria', 'descripcion', 'precio',
                                      'duracionMin', 'activo', 'createdAt', 'updatedAt'])
            && data.nombre is string && data.nombre.size() >= 3 && data.nombre.size() <= 60
            && data.categoria in ['vacunacion', 'peluqueria', 'bano', 'cirugia',
                                  'consulta_general', 'otro']
            && data.precio is number && data.precio > 0
            && data.duracionMin is int && data.duracionMin >= 5 && data.duracionMin <= 480
            && data.activo is bool
            && optString(data, 'descripcion', 1000);
        }
      }

      // ---------- Agenda: franjas horarias (RF-06) ----------
      // Id determinístico {fecha}_{hora} (p. ej. 2026-10-15_09:30).
      match /slots/{slotId} {
        allow read: if signedIn();

        // La clínica publica franjas 'disponible' (con servicio) o las
        // bloquea como 'no_disponible'. 'reservado_temporal' y 'ocupado' los
        // pone el flujo de agendamiento (RF-14), no la clínica.
        allow create: if hasRole('clinica')
          && isClinicOwner(clinicId)
          && validSlot(request.resource.data);

        // RF-06, flujo alterno: una franja con cita no se puede modificar.
        allow update: if hasRole('clinica')
          && isClinicOwner(clinicId)
          && !(resource.data.estado in ['ocupado', 'reservado_temporal'])
          && validSlot(request.resource.data);

        allow delete: if hasRole('clinica')
          && isClinicOwner(clinicId)
          && !(resource.data.estado in ['ocupado', 'reservado_temporal']);

        function validSlot(data) {
          return data.keys().hasOnly(['fecha', 'hora', 'inicio', 'serviceId', 'precio', 'estado'])
            && isDate(data.fecha) && isTime(data.hora)
            && slotId == data.fecha + '_' + data.hora
            && data.inicio is timestamp
            && data.estado in ['disponible', 'no_disponible']
            && (data.estado != 'disponible'
                || (data.get('serviceId', null) is string && data.serviceId.size() > 0))
            && (data.get('precio', null) == null
                || (data.precio is number && data.precio > 0));
        }
      }
    }

    // ---------- Código de paciente (semana 3) ----------
    // MSC-XXXX sin 0/O, 1/I ni L (PatientCode en lib/core/domain).
    function isPatientCode(code) {
      return code is string && code.matches('^MSC-[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{4}$');
    }

    // El código quedará (al terminar el lote) registrado para esta mascota.
    function codeIsFor(code, petId) {
      return existsAfter(/databases/$(database)/documents/codigosPaciente/$(code))
        && getAfter(/databases/$(database)/documents/codigosPaciente/$(code)).data.petId == petId;
    }

    // Clínica (activa) autorizada por el dueño para ver la mascota.
    function isAuthorizedClinic(petData) {
      return hasRole('clinica')
        && userData().get('clinicId', null) != null
        && userData().clinicId in petData.get('clinicasAutorizadas', []);
    }

    // codigosPaciente/{codigo} → {petId, ownerUid}. El id del documento hace
    // único el código: solo se puede CREAR, así que si ya existe el lote
    // entero falla y la app prueba otro. Nadie lo lee desde la app (lo usa
    // la Edge Function vincular-mascota con la cuenta de servicio).
    match /codigosPaciente/{codigo} {
      allow read, update, delete: if false;
      allow create: if hasRole('dueno')
        && isPatientCode(codigo)
        && request.resource.data.keys().hasOnly(['petId', 'ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.petId is string
        && getAfter(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.ownerUid
             == request.auth.uid
        && getAfter(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.codigoPaciente
             == codigo;
    }

    // ---------- pets (registro de mascotas, semana 2; vinculación, semana 3) ----------
    match /pets/{petId} {
      // El dueño lee sus mascotas (la app consulta where ownerUid == uid) y
      // las clínicas autorizadas las suyas (where clinicasAutorizadas
      // array-contains clinicId).
      allow read: if (isActive() && resource.data.ownerUid == request.auth.uid)
        || isAuthorizedClinic(resource.data);

      // Al crearla se registra su código en el mismo lote y empieza sin
      // clínicas autorizadas.
      allow create: if hasRole('dueno')
        && request.resource.data.ownerUid == request.auth.uid
        && validPet(request.resource.data)
        && isPatientCode(request.resource.data.get('codigoPaciente', null))
        && codeIsFor(request.resource.data.codigoPaciente, petId)
        && request.resource.data.get('clinicasAutorizadas', []).size() == 0;

      // El dueño edita sus datos; el código no cambia (salvo asignarlo una
      // vez a mascotas de la semana 2) y de clinicasAutorizadas solo puede
      // QUITAR clínicas (revocar acceso). Agregarlas solo lo hace la Edge
      // Function vincular-mascota.
      allow update: if hasRole('dueno')
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validPet(request.resource.data)
        && patientCodeUpdateValid()
        && resource.data.get('clinicasAutorizadas', [])
             .hasAll(request.resource.data.get('clinicasAutorizadas', []));

      allow delete: if hasRole('dueno') && resource.data.ownerUid == request.auth.uid;

      function patientCodeUpdateValid() {
        return !('codigoPaciente' in changedKeys())
          || (resource.data.get('codigoPaciente', null) == null
              && isPatientCode(request.resource.data.codigoPaciente)
              && codeIsFor(request.resource.data.codigoPaciente, petId));
      }

      function validPet(data) {
        return data.keys().hasOnly(['ownerUid', 'nombre', 'especie', 'raza', 'fechaNacimiento',
                                    'sexo', 'sexoDetalle', 'fotoPath', 'alergias', 'condiciones',
                                    'contactoEmergencia', 'codigoPaciente',
                                    'clinicasAutorizadas', 'createdAt'])
          // Obligatorios
          && data.nombre is string && data.nombre.size() >= 1 && data.nombre.size() <= 40
          && data.especie in ['perro', 'gato', 'ave', 'roedor', 'reptil', 'granja', 'exotico']
          // Opcionales
          && optString(data, 'raza', 60)
          && (data.get('sexo', null) == null
              || data.sexo in ['macho', 'hembra', 'indeterminado', 'otro'])
          // sexo 'otro' exige sexoDetalle (1–30 caracteres); con otro sexo no va.
          && (data.get('sexo', null) == 'otro'
              ? (data.get('sexoDetalle', null) is string
                 && data.sexoDetalle.size() >= 1 && data.sexoDetalle.size() <= 30)
              : data.get('sexoDetalle', null) == null)
          && (data.get('fechaNacimiento', null) == null
              || (data.fechaNacimiento is timestamp && data.fechaNacimiento <= request.time))
          // La foto solo puede estar en la carpeta del dueño (bucket mascotas).
          && (data.get('fotoPath', null) == null
              || (data.fotoPath is string
                  && data.fotoPath.matches('^' + request.auth.uid + '/' + petId + '/foto[.](jpg|png)$')))
          && data.get('alergias', []) is list && data.get('alergias', []).size() <= 30
          && data.get('condiciones', []) is list && data.get('condiciones', []).size() <= 30
          && data.get('clinicasAutorizadas', []) is list
          && data.get('clinicasAutorizadas', []).size() <= 50
          && (data.get('contactoEmergencia', null) == null
              || (data.contactoEmergencia is map
                  && data.contactoEmergencia.keys().hasOnly(['nombre', 'telefono'])
                  && data.contactoEmergencia.nombre is string
                  && data.contactoEmergencia.telefono is string
                  && data.contactoEmergencia.telefono.matches('^[0-9]{7,10}$')));
      }
    }

    // ---------- Todo lo demás está cerrado por defecto ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
