{
  "name": "mascoti-backend-tests",
  "private": true,
  "description": "Pruebas de firestore.rules y de la lógica de las Edge Functions de Supabase; scripts de administración",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mascoti \"vitest run --no-file-parallelism\"",
    "suspender": "node admin/suspender-cuenta.mjs",
    "verificar-geo": "node admin/verificar-geo-clinicas.mjs",
    "seed:historial": "node admin/seed-historial.mjs",
    "migrar-horario": "node admin/migrar-horario.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "geofire-common": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
